{
  "$schema": "vscode://schemas/color-theme",
  "name": "Nocturne (base)",
  "type": "dark",
  "colors": {
    "editor.background": "#1b1d23",
    "editor.foreground": "#c8ccd4",
    "foreground": "#c8ccd4",
    "focusBorder": "#5a9cf8",
    "editorGroup.border": "#2c2f36",
    "editorCursor.foreground": "#5a9cf8",
    "editorLineNumber.foreground": "#5c6370",
    "editorLineNumber.activeForeground": "#c8ccd4",
    "editor.lineHighlightBackground": "#22242b",
    "editor.selectionBackground": "#3e4451",
    "editorBracketMatch.background": "#2c313a",
    "editorBracketMatch.border": "#5a9cf8",
    "editorGutter.background": "#1b1d23",
    "editor.foldBackground": "#22242b",
    "scrollbarSlider.background": "#4e566680",
    "scrollbarSlider.hoverBackground": "#5a637580",
    "editorWidget.background": "#21232a",
    "dropdown.background": "#21232a",
    "sideBar.background": "#17191e",
    "sideBar.foreground": "#c8ccd4",
    "sideBar.border": "#2c2f36",
    "activityBar.background": "#131519",
    "input.background": "#1b1d23",
    "input.border": "#2c2f36",
    "input.placeholderForeground": "#5c6370",
    "tab.activeBackground": "#1b1d23",
    "tab.inactiveBackground": "#17191e",
    "tab.activeBorderTop": "#5a9cf8",
    "list.hoverBackground": "#2c313a",
    "list.activeSelectionBackground": "#3a3f4b",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#2c313a",
    "button.background": "#5a9cf8",
    "button.foreground": "#0b0d11",
    "textLink.foreground": "#5a9cf8",
    "descriptionForeground": "#7f8694",
    "disabledForeground": "#4b515c",
    "editorError.foreground": "#e06c75",
    "editorWarning.foreground": "#e5c07b",
    "editorInfo.foreground": "#5a9cf8",
    "gitDecoration.addedResourceForeground": "#98c379",
    "gitDecoration.deletedResourceForeground": "#e06c75",
    "gitDecoration.modifiedResourceForeground": "#e5c07b",
    "gitDecoration.untrackedResourceForeground": "#98c379",
    "diffEditor.insertedTextBackground": "#98c37926",
    "diffEditor.removedTextBackground": "#e06c7526",
    "diffEditor.insertedLineBackground": "#98c37914",
    "diffEditor.removedLineBackground": "#e06c7514",
    "terminal.background": "#1b1d23",
    "terminal.foreground": "#c8ccd4",
    "terminal.selectionBackground": "#3e4451",
    "terminal.ansiBlack": "#282c34",
    "terminal.ansiRed": "#e06c75",
    "terminal.ansiGreen": "#98c379",
    "terminal.ansiYellow": "#e5c07b",
    "terminal.ansiBlue": "#5a9cf8",
    "terminal.ansiMagenta": "#c678dd",
    "terminal.ansiCyan": "#56b6c2",
    "terminal.ansiWhite": "#abb2bf",
    "terminal.ansiBrightBlack": "#5c6370",
    "terminal.ansiBrightRed": "#e06c75",
    "terminal.ansiBrightGreen": "#98c379",
    "terminal.ansiBrightYellow": "#e5c07b",
    "terminal.ansiBrightBlue": "#5a9cf8",
    "terminal.ansiBrightMagenta": "#c678dd",
    "terminal.ansiBrightCyan": "#56b6c2",
    "terminal.ansiBrightWhite": "#ffffff",
    "statusBar.background": "#17191e",
    "statusBar.foreground": "#c8ccd4",
    "titleBar.activeBackground": "#17191e",
    "minimap.background": "#1b1d23",
    "minimapSlider.background": "#4e566640",
    "editorOverviewRuler.border": "#2c2f36",
    "editorIndentGuide.background1": "#2c2f36",
    "peekView.border": "#5a9cf8",
    "peekViewEditor.background": "#22242b",
    "notifications.background": "#21232a",
    "notificationCenterHeader.background": "#17191e",
    "debugToolBar.background": "#21232a",
    "merge.currentHeaderBackground": "#98c37944",
    "breadcrumb.foreground": "#7f8694",
    "menu.background": "#21232a",
    "quickInput.background": "#21232a",
    "badge.background": "#5a9cf8",
    "symbolIcon.classForeground": "#e5c07b",
    "welcomePage.background": "#1b1d23",
    "notebook.cellBorderColor": "#2c2f36",
    "testing.iconPassed": "#98c379"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#5c6370", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#98c379" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#56b6c2" } },
    { "scope": "string.regexp", "settings": { "foreground": "#c678dd" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#d19a66" } },
    { "scope": "constant.language.boolean", "settings": { "foreground": "#d19a66" } },
    { "scope": "constant.language.null", "settings": { "foreground": "#e06c75" } },
    { "scope": ["constant.other", "constant"], "settings": { "foreground": "#d19a66" } },
    { "scope": "keyword", "settings": { "foreground": "#c678dd" } },
    { "scope": "keyword.control", "settings": { "foreground": "#c678dd", "fontStyle": "italic" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#56b6c2" } },
    { "scope": "storage.type", "settings": { "foreground": "#c678dd" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#61afef" } },
    { "scope": "support.function", "settings": { "foreground": "#61afef" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#e5c07b" } },
    { "scope": ["entity.name.class", "support.type"], "settings": { "foreground": "#e5c07b" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#e06c75" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#d19a66" } },
    { "scope": "variable", "settings": { "foreground": "#c8ccd4" } },
    { "scope": "variable.other.property", "settings": { "foreground": "#56b6c2" } },
    { "scope": "variable.language", "settings": { "foreground": "#e06c75", "fontStyle": "italic" } },
    { "scope": "punctuation", "settings": { "foreground": "#abb2bf" } },
    { "scope": "meta.preprocessor", "settings": { "foreground": "#c678dd" } },
    { "scope": "entity.name", "settings": { "foreground": "#e5c07b" } },
    { "scope": "markup.heading", "settings": { "foreground": "#61afef", "fontStyle": "bold" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.inserted", "settings": { "foreground": "#98c379" } },
    { "scope": "markup.deleted", "settings": { "foreground": "#e06c75" } },
    { "scope": "meta.diff.header", "settings": { "foreground": "#61afef" } }
  ]
}
