{
  // Nocturne Bright: the base theme with a lifted background and a few
  // semantic overrides. `include` is resolved relative to this file.
  "$schema": "vscode://schemas/color-theme",
  "name": "Nocturne Bright",
  "include": "./vscode-base.json",
  "colors": {
    "editor.background": "#20232b",
    "sideBar.background": "#1b1e25",
    "focusBorder": "#7aa2f7",
    "textLink.foreground": "#7aa2f7",
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#6b7280", "fontStyle": "italic" } },
  ],
  "semanticTokenColors": {
    "property": "#8ec07c",
    "parameter": { "foreground": "#d7bfa6" },
    "class": { "foreground": "#e5c07b", "fontStyle": "italic" },
    "variable.readonly.defaultLibrary": { "foreground": "#e06c75" },
    "*.declaration": { "bold": true }
  }
}
